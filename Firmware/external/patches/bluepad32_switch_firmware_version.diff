+
+bool uni_hid_parser_switch_get_firmware_version(const uni_hid_device_t* d, uint8_t* major, uint8_t* minor) {
+    if (!d || (d->controller_type != CONTROLLER_TYPE_SwitchProController &&
+               d->controller_type != CONTROLLER_TYPE_SwitchJoyConLeft &&
+               d->controller_type != CONTROLLER_TYPE_SwitchJoyConRight))
+        return false;
+    const switch_instance_t* ins = get_switch_instance((uni_hid_device_t*)d);
+    if (ins->state < STATE_READY)
+        return false;
+    *major = ins->firmware_version_hi;
+    *minor = ins->firmware_version_lo;
+    return true;
+}
