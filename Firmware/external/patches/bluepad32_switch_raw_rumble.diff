+void uni_hid_parser_switch_play_raw_rumble(struct uni_hid_device_s* d, const uint8_t blocks[8]) {
+    if (d == NULL || blocks == NULL) {
+        loge("Switch: Invalid device\n");
+        return;
+    }
+    switch_instance_t* ins = get_switch_instance(d);
+    if (ins->state < STATE_READY)
+        return;
+
+    // Calls off a pending or playing strength rumble (its timers would stop or restart it).
+    uni_hid_parser_rumble_stop_timers(d);
+
+    struct switch_subcmd_request req = {
+        .report_id = OUTPUT_RUMBLE_ONLY,
+    };
+    memcpy(req.rumble_left, &blocks[0], sizeof(req.rumble_left));
+    memcpy(req.rumble_right, &blocks[4], sizeof(req.rumble_right));
+
+    // Rumble request don't include the last byte of "switch_subcmd_request": subcmd_id
+    send_subcmd(d, &req, sizeof(req) - 1);
+}
