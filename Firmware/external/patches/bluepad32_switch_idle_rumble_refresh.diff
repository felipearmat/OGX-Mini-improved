+// Re-send a neutral rumble packet while no rumble is playing (OGX-Mini-improved). A pad keeps
+// vibrating with the last rumble data it received, and rumble is stopped by a single packet: if
+// that one is dropped (full outgoing queue) or ignored, the motor stays on forever. Calling this
+// periodically while idle heals such a stuck rumble.
+void uni_hid_parser_switch_refresh_idle_rumble(struct uni_hid_device_s* d) {
+    if (!d || d->report_parser.setup != uni_hid_parser_switch_setup)
+        return;
+    switch_instance_t* ins = get_switch_instance(d);
+    if (ins->state != STATE_READY || ins->rumble_state != SWITCH_STATE_RUMBLE_DISABLED)
+        return;
+    struct switch_subcmd_request req = {0};
+    req.report_id = OUTPUT_RUMBLE_ONLY;
+    const uint8_t neutral[4] = {0x00, 0x01, 0x40, 0x40};
+    memcpy(req.rumble_left, neutral, sizeof(req.rumble_left));
+    memcpy(req.rumble_right, neutral, sizeof(req.rumble_right));
+    // Rumble requests don't include the last byte of "switch_subcmd_request": subcmd_id
+    send_subcmd(d, &req, sizeof(req) - 1);
+}
